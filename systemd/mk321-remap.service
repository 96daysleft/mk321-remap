[Unit]
Description=Remap the PCsensor MK321 mini keyboard
Documentation=https://github.com/96daysleft/mk321-remap
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=%h/.local/bin/mk321-remap run
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
